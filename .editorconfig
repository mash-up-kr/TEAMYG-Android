root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# ── 기본 포맷 ──────────────────────────────────────────
indent_size = 4
max_line_length = 120

# ktlint가 적용할 코드 스타일을 IntelliJ IDEA 기본 스타일로 지정
ktlint_code_style = intellij_idea

# 백틱(`)으로 감싼 식별자(예: 테스트 함수명 `should do something`)는 네이밍 규칙 검사에서 제외
ktlint_ignore_back_ticked_identifier = true

# @Composable 어노테이션이 붙은 함수는 함수 네이밍 규칙(소문자 카멜케이스) 검사에서 제외
ktlint_function_naming_ignore_when_annotated_with = Composable

# 함수를 표현식 본문(= 형태)으로 강제하는 규칙 비활성화
ktlint_standard_function-expression-body = disabled

# 프로퍼티 네이밍 규칙 비활성화
ktlint_standard_property-naming = disabled

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4

