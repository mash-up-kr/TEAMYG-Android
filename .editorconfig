root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# ── 기본 포맷 ──────────────────────────────────────────
indent_size = 4
max_line_length = 120

# ── Ktlint 기본 설정 ───────────────────────────────────
# ktlint_official 스타일 적용 (대대부분의 standard & naming 규칙 자동 활성화)
ktlint_code_style = ktlint_official

# ── Compose 맞춤 설정 ──────────────────────────────────
# Composable 함수는 대문자로 시작하는 것을 허용 (Compose 개발 시 필수)
ktlint_function_naming_ignore_when_annotated_with = Composable

# ── Trailing Comma 강제 (Kotlin 1.4+ 트렌드) ───────────
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_standard_trailing-comma-on-call-site = enabled
ktlint_standard_trailing-comma-on-declaration-site = enabled

# ── Import & 패키지 설정 ───────────────────────────────
# 와일드카드(*) import 완전 금지 (명시적 import 강제)
ij_kotlin_packages_to_use_import_on_demand = unset
ktlint_standard_no-wildcard-imports = enabled

# ── 명시적 비활성화 규칙 (호불호 및 생산성 고려) ────────
# 멀티라인 표현식에서 우변을 무조건 다음 줄로 넘기는 규칙 (코드가 너무 길어지는 현상 방지)
ktlint_standard_multiline-expression-wrapping = disabled

# 함수 시그니처 자동 정리 (개발자가 의도한 줄바꿈을 유지하기 위해 끔)
ktlint_standard_function-signature = disabled

# 파라미터 리스트 내부 공백 일관성 (가독성을 위한 수동 공백 허용)
ktlint_standard_parameter-list-spacing = disabled

# 클래스 시그니처 자동 정렬 끄기 (Hilt @Inject 및 긴 제네릭 상속 시 줄바꿈 강제 방지)
ktlint_standard_class-signature = disabled

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4

