<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- API 29+는 자기 앱이 만든 MediaStore 항목을 쓰는 데 권한이 필요 없다 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <provider
            android:name="com.teamyg.parfait.data.utils.RecentImageFileProvider"
            android:authorities="${applicationId}.recent.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/recent_image_file_paths" />
        </provider>

        <provider
            android:name="com.teamyg.parfait.data.utils.CameraCacheFileProvider"
            android:authorities="${applicationId}.camera.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_file_paths" />
        </provider>
    </application>

</manifest>
