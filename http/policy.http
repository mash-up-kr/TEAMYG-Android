### 약관 API — 현재 유효 약관 목록 조회
#
# 서버: mash-up-kr/TEAMYG-SERVER (main)
# 실행: 요청 왼쪽 ▶️ → 환경 `dev` 선택
#
# 회원가입(auth.http 2번)이 요구하는 termsId 의 출처다. 이 요청을 먼저 실행하면
# 응답의 termsId 가 terms_id_1 / terms_id_2 전역 변수로 저장되고 signup 이 그대로 쓴다.

### 1. 약관 목록 조회
# 인증 불필요(화이트리스트 /api/v1/policies). 요청 파라미터·바디 없음.
#
# ⚠️ 컨트롤러는 http/auth 패키지에 있고 스웨거 태그도 Auth 지만 경로는 /api/v1/auth 하위가
#    아니라 최상위 /api/v1/policies 다.
# ⚠️ 약관이 없으면 200 + policies: [] 다. 에러가 아니다 — 배열 길이를 반드시 확인한다.
#    빈 배열인 채로 signup 을 호출하면 400 REQUIRED_TERMS_NOT_AGREED 가 난다.
# ⚠️ 타입당 최신 1건씩만 온다(TERMS_OF_SERVICE, PRIVACY_POLICY) — 길이는 0~2다.
#    순서는 서버가 TERMS_OF_SERVICE → PRIVACY_POLICY 로 고정한다(PolicyQueryService).
# ⚠️ url 은 전용 컬럼이 아니라 tos.content(LONGTEXT) 컬럼을 그대로 매핑한 값이다.
#    운영 데이터에 약관 전문이 들어 있으면 링크가 아니라 전문이 내려온다.
# ⚠️ Authorization 헤더를 붙이지 마라. 화이트리스트지만 JwtAuthFilter 는 여기서도 실행돼
#    만료 토큰을 붙이면 401 이 난다(reissue 와 같은 함정).
# 이 엔드포인트 전용 에러 코드는 없다. 남는 건 전역 500 INTERNAL_SERVER_ERROR 뿐이다.
GET {{base_url}}/api/v1/policies

> {%
    client.test("200 성공", function() {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.success === true, "code: " + response.body.code);
    });

    const policies = response.body.data.policies;

    client.test("policies 는 배열", function() {
        client.assert(Array.isArray(policies), "policies 가 배열이 아님");
    });

    if (policies.length === 0) {
        client.log("⚠️ 약관이 0건이다. signup 은 400 REQUIRED_TERMS_NOT_AGREED 가 난다 — 서버팀에 DB 확인 요청.");
    } else {
        policies.forEach(function(p, i) {
            client.global.set("terms_id_" + (i + 1), p.termsId);
            client.log("[" + (i + 1) + "] termsId=" + p.termsId + " type=" + p.type +
                       " required=" + p.required + " title=" + p.title);
            client.log("    url=" + p.url.substring(0, 80) + (p.url.length > 80 ? "..." : ""));
        });
        // signup 바디가 항목 2개를 보내므로, 1건만 왔으면 두 번째도 같은 id 로 채워 400 을 피한다.
        if (policies.length === 1) {
            client.global.set("terms_id_2", policies[0].termsId);
            client.log("⚠️ 약관이 1건뿐이다 — terms_id_2 를 같은 값으로 채웠다. signup 바디의 중복 항목을 지워야 400 DUPLICATE_TERMS_ID 를 피한다.");
        }
        client.log("→ terms_id_1/terms_id_2 저장 완료. 다음은 auth.http '2. 회원가입 완료'");
    }
%}

### 2. (대조용) Authorization 을 붙여서 호출
# 화이트리스트 경로에서도 JwtAuthFilter 가 도는 것을 확인하는 요청이다.
# 유효한 access token 이면 200, 만료·위조 토큰이면 401 이 난다 — 인가(permitAll)와 필터는 별개다.
GET {{base_url}}/api/v1/policies
Authorization: Bearer {{access_token}}

> {%
    client.log("status=" + response.status + " code=" + (response.body ? response.body.code : "(본문 없음)"));
%}
